# Copy this file to .env and set the values for the machine that runs or builds the panel.
# .env is git-ignored, so each machine keeps its own.
#
# VITE_* values are built into the JavaScript sent to browsers: never put secrets here,
# and rebuild (npm run build) after changing a value.

# The site's API, without a trailing slash.
#   Production:  https://vacationrentalhotline.com/api
#   Developing:  http://localhost:3000/api  (the site running locally)
VITE_API_BASE_URL=http://localhost:3000/api
